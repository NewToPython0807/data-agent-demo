# 配置示例（T03）：复制本文件为 .env 并按需填写。
# 所有键均可被环境变量覆盖（环境变量优先）。

# ===== 服务 =====
APP_NAME=智能问数 Data Agent
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== 数据库（SQLite 单文件，路径相对项目根目录）=====
DATABASE_PATH=data/agent.db

# ===== 会话（签名 Cookie）=====
# 生产环境必须设置：一段随机长字符串（例如 `python -c "import secrets;print(secrets.token_hex(32))"`）
# 不设置则每次启动随机生成，重启后所有已登录会话失效。
SECRET_KEY=
SESSION_COOKIE_NAME=agent_session
# 会话有效期（秒），默认 604800 = 7 天
SESSION_MAX_AGE_SECONDS=604800

# ===== 单账号 =====
# 登录用户名
ACCOUNT_USERNAME=admin
# 密码的 bcrypt 哈希（T07 将提供生成命令），不要直接填明文密码
ACCOUNT_PASSWORD_HASH=

# ===== DeepSeek（自然语言 → SQL 生成）=====
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 调用超时（秒）
LLM_TIMEOUT_SECONDS=60

# ===== 多轮追问上下文（最近 N 轮，可配置）=====
MULTI_TURN_CONTEXT_ROUNDS=5

# ===== 上传 =====
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=50
